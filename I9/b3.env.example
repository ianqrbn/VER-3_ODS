# Barramento B3 (broker externo). Copie para b3.env, que fica fora do git.
KAFKA_BOOTSTRAP_SERVERS=34.66.235.91:9093

# Protocolo e credenciais a confirmar com o TRA-1 (dono do B3).
# PLAINTEXT, SSL, SASL_PLAINTEXT ou SASL_SSL
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# PLAIN, SCRAM-SHA-256 ou SCRAM-SHA-512 (só com SASL_*)
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# certificado da CA, caminho dentro do container (só com SSL/SASL_SSL)
KAFKA_SSL_CA_LOCATION=

# Grupo de consumo do I9 no barramento compartilhado
I9_KAFKA_GROUP_ID=ods-i9
